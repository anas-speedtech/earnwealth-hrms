# Database connection (individual fields — construct DATABASE_URL from these)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ews-hrms
DB_USER=db_user
DB_PASSWORD=
DATABASE_URL=

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long-dev-only
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (required for password reset links)
# Leave blank and password reset returns 503 rather than pretending to send.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# and an app-specific password (not the account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=EWS HRMS

# Application
APP_URL=http://localhost:5173
APP_NAME=EWS HRMS
