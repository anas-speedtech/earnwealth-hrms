generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String    @db.VarChar(255)
  role              String    @db.VarChar(20)
  status            String    @default("ACTIVE") @db.VarChar(20)
  lastLoginAt       DateTime? @db.DateTime(0)
  passwordChangedAt DateTime? @db.DateTime(0)
  createdAt         DateTime  @default(now()) @db.DateTime(0)
  updatedAt         DateTime  @updatedAt @db.DateTime(0)

  refreshTokens      RefreshToken[]
  passwordResetToken PasswordResetToken?
  superAdminProfile SuperAdminProfile?
  adminProfile      AdminProfile?
  hrProfile         HRProfile?
  employeeProfile   EmployeeProfile?

  @@map("users")
}

model SuperAdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime  @updatedAt @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("super_admin_profiles")
}

model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime  @updatedAt @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model HRProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime  @updatedAt @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hr_profiles")
}

model EmployeeProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  employeeCode   String   @unique @db.VarChar(20)
  firstName      String   @db.VarChar(50)
  lastName       String   @db.VarChar(50)
  dateOfBirth    DateTime? @db.Date
  gender         String?  @db.VarChar(10)
  phoneNumber    String?  @db.VarChar(20)
  personalEmail  String?  @db.VarChar(100)
  address        String?  @db.Text
  departmentId   String?
  designationId  String?
  managerId      String?
  employmentType String   @default("FULL_TIME") @db.VarChar(20)
  joiningDate    DateTime @db.Date
  status         String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @db.DateTime(0)
  updatedAt      DateTime  @updatedAt @db.DateTime(0)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department?   @relation(fields: [departmentId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])
  manager    EmployeeProfile? @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates EmployeeProfile[] @relation("EmployeeManager")

  attendances Attendance[]
  workSessions WorkSession[]
  wfhRequests WFHRequest[]
  attendanceCorrections AttendanceCorrection[]

  @@index([departmentId])
  @@index([designationId])
  @@index([managerId])
  @@map("employee_profiles")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(0)
  updatedAt   DateTime @updatedAt @db.DateTime(0)

  employees EmployeeProfile[]

  @@unique([name])
  @@map("departments")
}

model Designation {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(0)
  updatedAt   DateTime @updatedAt @db.DateTime(0)

  employees EmployeeProfile[]

  @@unique([name])
  @@map("designations")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @db.VarChar(255)
  expiresAt  DateTime @db.DateTime(0)
  revokedAt  DateTime? @db.DateTime(0)
  createdAt  DateTime @default(now()) @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  tokenHash String   @db.VarChar(255)
  used      Boolean  @default(false)
  usedAt    DateTime? @db.DateTime(0)
  expiresAt DateTime @db.DateTime(0)
  createdAt DateTime @default(now()) @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model InvitationToken {
  id        String   @id @default(uuid())
  email     String   @db.VarChar(100)
  tokenHash String   @db.VarChar(255)
  role      String   @db.VarChar(20)
  used      Boolean  @default(false)
  usedAt    DateTime? @db.DateTime(0)
  expiresAt DateTime @db.DateTime(0)
  createdAt DateTime @default(now()) @db.DateTime(0)

  @@index([email])
  @@map("invitation_tokens")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actorRole   String   @db.VarChar(20)
  action      String   @db.VarChar(50)
  entityType  String   @db.VarChar(50)
  entityId    String
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(255)
  metadata    String?  @db.Text
  createdAt   DateTime @default(now()) @db.DateTime(0)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Attendance {
  id           String   @id @default(uuid())
  employeeId   String
  date         DateTime @db.Date
  workMode     String   @default("OFFICE") @db.VarChar(10)
  status       String   @default("PRESENT") @db.VarChar(20)
  totalMinutes Int?     @default(0)
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @db.DateTime(0)
  updatedAt    DateTime @updatedAt @db.DateTime(0)

  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessions   WorkSession[]
  corrections AttendanceCorrection[]

  @@unique([employeeId, date], name: "attendance_employee_date")
  @@index([employeeId, date])
  @@map("attendances")
}

model WorkSession {
  id           String   @id @default(uuid())
  attendanceId String
  employeeId   String
  punchIn      DateTime @db.DateTime(0)
  punchOut     DateTime? @db.DateTime(0)
  durationMinutes Int  @default(0)
  createdAt    DateTime @default(now()) @db.DateTime(0)

  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([employeeId, punchIn])
  @@map("work_sessions")
}

model AttendanceCorrection {
  id              String   @id @default(uuid())
  attendanceId    String
  employeeId      String
  originalPunchIn DateTime? @db.DateTime(0)
  originalPunchOut DateTime? @db.DateTime(0)
  originalStatus  String?  @db.VarChar(20)
  correctedPunchIn  DateTime? @db.DateTime(0)
  correctedPunchOut DateTime? @db.DateTime(0)
  correctedStatus  String?  @db.VarChar(20)
  reason          String   @db.Text
  status          String   @default("PENDING") @db.VarChar(20)
  reviewedBy      String?
  reviewedAt      DateTime? @db.DateTime(0)
  reviewComment   String?  @db.Text
  createdAt       DateTime @default(now()) @db.DateTime(0)
  updatedAt       DateTime @updatedAt @db.DateTime(0)

  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@map("attendance_corrections")
}

model WFHRequest {
  id           String   @id @default(uuid())
  employeeId   String
  requestDate  DateTime @db.Date
  reason       String   @db.Text
  status       String   @default("PENDING") @db.VarChar(20)
  reviewedBy   String?
  reviewedAt   DateTime? @db.DateTime(0)
  reviewComment String? @db.Text
  createdAt    DateTime @default(now()) @db.DateTime(0)
  updatedAt    DateTime @updatedAt @db.DateTime(0)

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, requestDate, status])
  @@map("wfh_requests")
}

// ==================== LEAVE MANAGEMENT MODELS ====================

model Holiday {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  date      DateTime @db.Date
  type      String   @default("PUBLIC") @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(0)

  @@unique([date])
  @@map("holidays")
}

model LeaveType {
  id               String   @id @default(uuid())
  name             String   @unique @db.VarChar(50)
  displayName      String   @db.VarChar(100)
  description      String?  @db.Text
  code             String   @unique @db.VarChar(20)
  classification   String   @default("PAID") @db.VarChar(10)
  isHalfDayAllowed Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.DateTime(0)
  updatedAt        DateTime @updatedAt @db.DateTime(0)

  policies  LeavePolicy[]
  balances  LeaveBalance[]
  requests  LeaveRequest[]

  @@map("leave_types")
}

model LeavePolicy {
  id                      String   @id @default(uuid())
  leaveTypeId             String
  annualEntitlementDays   Decimal  @db.Decimal(5, 2)
  accrualFrequency        String   @default("ANNUAL") @db.VarChar(10)
  monthlyAccrualDays      Decimal? @db.Decimal(5, 2)
  carryForwardEnabled     Boolean  @default(false)
  maxCarryForwardDays     Decimal? @db.Decimal(5, 2)
  carryForwardExpiryMonths Int    @default(12)
  minDaysBeforeApply      Int      @default(0)
  maxConsecutiveDays      Int?
  requiresApproval        Boolean  @default(true)
  applicableTo            String   @default("ALL") @db.VarChar(20)
  departmentIds           String?  @db.Text
  isActive                Boolean  @default(true)
  effectiveFrom           DateTime @db.Date
  effectiveTo             DateTime? @db.Date
  createdAt               DateTime @default(now()) @db.DateTime(0)
  updatedAt               DateTime @updatedAt @db.DateTime(0)

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([leaveTypeId])
  @@map("leave_policies")
}

model LeaveBalance {
  id               String    @id @default(uuid())
  employeeId       String
  leaveTypeId      String
  openingBalance   Decimal   @default(0) @db.Decimal(6, 2)
  accruedBalance   Decimal   @default(0) @db.Decimal(6, 2)
  usedBalance      Decimal   @default(0) @db.Decimal(6, 2)
  reservedBalance  Decimal   @default(0) @db.Decimal(6, 2)
  availableBalance Decimal   @default(0) @db.Decimal(6, 2)
  year             Int
  lastAccruedAt    DateTime? @db.DateTime(0)
  createdAt        DateTime  @default(now()) @db.DateTime(0)
  updatedAt        DateTime  @updatedAt @db.DateTime(0)

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, leaveTypeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id            String   @id @default(uuid())
  employeeId    String
  leaveTypeId   String
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  isHalfDay     Boolean  @default(false)
  halfDayPeriod String?  @db.VarChar(10)
  totalDays     Decimal  @db.Decimal(5, 2)
  reason        String   @db.Text
  status        String   @default("PENDING") @db.VarChar(20)
  reviewedBy    String?
  reviewedAt    DateTime? @db.DateTime(0)
  reviewComment String?  @db.Text
  createdAt     DateTime @default(now()) @db.DateTime(0)
  updatedAt     DateTime @updatedAt @db.DateTime(0)

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status, startDate])
  @@index([status, createdAt])
  @@map("leave_requests")
}

model LeaveTransaction {
  id            String    @id @default(uuid())
  employeeId    String
  leaveTypeId   String
  leaveRequestId String?
  type          String    @db.VarChar(20)
  amount        Decimal   @db.Decimal(6, 2)
  balanceBefore Decimal   @db.Decimal(6, 2)
  balanceAfter  Decimal   @db.Decimal(6, 2)
  reason        String?   @db.Text
  createdBy     String
  createdAt     DateTime  @default(now()) @db.DateTime(0)

  @@index([employeeId, leaveTypeId, createdAt])
  @@map("leave_transactions")
}

// ==================== PAYROLL MODELS ====================

model SalaryStructure {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  monthlyCTC    Decimal  @db.Decimal(12, 2)
  currency     String   @default("INR") @db.VarChar(3)
  isActive     Boolean  @default(true)
  effectiveFrom DateTime @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt    DateTime @default(now()) @db.DateTime(0)
  updatedAt    DateTime  @updatedAt @db.DateTime(0)

  components  SalaryComponent[]
  payrolls    PayrollRecord[]

  @@index([employeeId])
  @@map("salary_structures")
}

model SalaryComponent {
  id           String   @id @default(uuid())
  salaryStructureId String
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  type         String   @db.VarChar(10) // EARNING | DEDUCTION
  calculationType String @default("FIXED") @db.VarChar(20) // FIXED | PERCENTAGE_OF_CTC | PERCENTAGE_OF_BASIC | FORMULA
  amount       Decimal? @db.Decimal(12, 2)
  percentage   Decimal? @db.Decimal(5, 2)
  formula      String?  @db.Text
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.DateTime(0)
  updatedAt    DateTime  @updatedAt @db.DateTime(0)

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@index([salaryStructureId])
  @@map("salary_components")
}

model PayrollRecord {
  id           String   @id @default(uuid())
  employeeId   String
  salaryStructureId String
  month        Int
  year         Int
  status       String   @default("DRAFT") @db.VarChar(20) // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED
  grossEarnings Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @default(0) @db.Decimal(12, 2)
  netPay       Decimal  @default(0) @db.Decimal(12, 2)
  preparedBy   String
  preparedAt   DateTime @default(now()) @db.DateTime(0)
  submittedAt  DateTime? @db.DateTime(0)
  approvedBy   String?
  approvedAt   DateTime? @db.DateTime(0)
  rejectionReason String? @db.Text
  reviewComment   String? @db.Text
  createdAt    DateTime @default(now()) @db.DateTime(0)
  updatedAt    DateTime  @updatedAt @db.DateTime(0)

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  components PayrollComponent[]
  payslips Payslip[]

  @@unique([employeeId, month, year], name: "payroll_employee_period")
  @@index([employeeId, year, month])
  @@index([status, createdAt])
  @@map("payroll_records")
}

model PayrollComponent {
  id              String   @id @default(uuid())
  payrollRecordId String
  salaryComponentId String
  name            String   @db.VarChar(100)
  type            String   @db.VarChar(10) // EARNING | DEDUCTION
  amount          Decimal  @db.Decimal(12, 2)
  sortOrder       Int      @default(0)

  payrollRecord PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)

  @@index([payrollRecordId])
  @@map("payroll_components")
}

model Payslip {
  id           String   @id @default(uuid())
  payrollRecordId String   @unique
  employeeId   String
  month        Int
  year         Int
  pdfPath      String?  @db.VarChar(255)
  generatedBy  String
  generatedAt  DateTime @default(now()) @db.DateTime(0)

  payrollRecord PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year], name: "payslip_employee_period")
  @@index([employeeId, month, year])
  @@map("payslips")
}

// ==================== COMP-OFF MODELS ====================

model CompOffPolicy {
  id                    String   @id @default(uuid())
  isEnabled             Boolean  @default(true)
  creditExpiryMonths    Int?     @default(6)
  minWorkingMinutes     Int?     @default(480)
  maxCreditsPerMonth    Int?     @default(4)
  applicableOnWeekends  Boolean  @default(true)
  applicableOnHolidays  Boolean  @default(true)
  applicableOnWeekoffs   Boolean  @default(false)
  createdAt             DateTime @default(now()) @db.DateTime(0)
  updatedAt             DateTime @updatedAt @db.DateTime(0)

  @@map("comp_off_policies")
}

model CompOffCredit {
  id              String   @id @default(uuid())
  employeeId      String
  sourceDate      DateTime @db.Date
  attendanceId    String?
  credits         Decimal  @db.Decimal(5, 2)
  remainingAmount Decimal @db.Decimal(5, 2)
  status          String   @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | REJECTED | EXPIRED | USED
  expiresAt       DateTime? @db.DateTime(0)
  approvedBy      String?
  approvedAt      DateTime? @db.DateTime(0)
  rejectionReason String?  @db.Text
  createdAt       DateTime @default(now()) @db.DateTime(0)
  updatedAt       DateTime @updatedAt @db.DateTime(0)

  @@unique([employeeId, sourceDate], name: "comp_off_employee_date")
  @@index([employeeId, status])
  @@index([employeeId, expiresAt])
  @@map("comp_off_credits")
}

model CompOffLedger {
  id              String   @id @default(uuid())
  employeeId      String
  creditId        String?
  type            String   @db.VarChar(20) // EARNED | USED | EXPIRED | RELEASED | MANUAL_ADJUST
  amount          Decimal  @db.Decimal(6, 2)
  balanceBefore   Decimal  @db.Decimal(6, 2)
  balanceAfter    Decimal  @db.Decimal(6, 2)
  reason          String?  @db.Text
  relatedLeaveId  String?
  createdBy       String
  createdAt       DateTime @default(now()) @db.DateTime(0)

  @@index([employeeId, createdAt])
  @@index([creditId])
  @@map("comp_off_ledger")
}

model CompOffLeave {
  id              String   @id @default(uuid())
  employeeId      String
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  isHalfDay       Boolean  @default(false)
  halfDayPeriod   String?  @db.VarChar(10)
  totalDays       Decimal  @db.Decimal(5, 2)
  status          String   @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | REJECTED | CANCELLED
  reviewedBy      String?
  reviewedAt      DateTime? @db.DateTime(0)
  reviewComment   String?  @db.Text
  createdAt       DateTime @default(now()) @db.DateTime(0)
  updatedAt       DateTime @updatedAt @db.DateTime(0)

  @@index([employeeId, status, startDate])
  @@index([status, createdAt])
  @@map("comp_off_leaves")
}
