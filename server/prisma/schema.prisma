// Prisma schema for EWS HRMS.
//
// This file describes the database as it actually exists. The live tables use
// INT auto-increment primary keys and a `users.role` enum of
// SUPER_ADMIN, ADMIN, HR_MANAGER, EMPLOYEE.
//
// The previous revision of this file declared String/uuid ids and a `status`
// column on `users`, neither of which exists in the live database. Every
// service using Prisma models then failed with "Error converting field id of
// expected non-nullable type String, found incompatible value of 5".
//
// If you change a model here, apply it with a migration. Do not run
// `prisma db push` against a database that holds real data without reading the
// diff first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- users

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         String   @default("EMPLOYEE") @db.VarChar(20)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  employee           Employee?
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  employeeProfiles  EmployeeProfile[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ------------------------------------------------------------ employees

model Employee {
  id             Int      @id @default(autoincrement())
  userId         Int?     @unique
  employeeCode   String   @unique @db.VarChar(50)
  name           String   @db.VarChar(120)
  designation    String   @db.VarChar(100)
  joiningDate    DateTime @db.Date
  deviceEnrollNo Int      @unique
  basicSalary    Decimal  @db.Decimal(12, 2)
  allowances     Decimal  @default(0) @db.Decimal(12, 2)
  deductions     Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)
  departmentId   Int?
  departmentText String?  @db.VarChar(100)

  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendanceLogs AttendanceLog[]
  leaves         Leave[]
  salarySlips    SalarySlip[]
  compOffCredits CompOffCredit[]
  compOffLedger  CompOffLedger[]

  @@index([userId])
  @@index([deviceEnrollNo])
  @@index([employeeCode])
  @@index([departmentId])
  @@map("employees")
}

// --------------------------------------------------------- departments

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  headId      Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  employees Employee[]

  @@index([name])
  @@map("departments")
}

// ---------------------------------------------------------- attendance

model AttendanceLog {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  punchTime     DateTime @db.DateTime
  status        String   @default("UNKNOWN") @db.VarChar(10)
  source        String   @default("MANUAL") @db.VarChar(10)
  importBatchId Int?
  createdAt     DateTime @default(now()) @db.DateTime(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceCorrections AttendanceCorrection[]

  @@unique([employeeId, punchTime])
  @@index([employeeId, punchTime])
  @@index([punchTime])
  @@index([importBatchId])
  @@map("attendance_logs")
}

// --------------------------------------------------------------- leaves

model Leave {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  type         String   @default("CASUAL") @db.VarChar(20)
  status       String   @default("PENDING") @db.VarChar(20)
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  reason       String?  @db.VarChar(500)
  approverId   Int?
  approverNote String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@map("leaves")
}

// ------------------------------------------------------------- holidays

model Holiday {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(120)
  date        DateTime @db.Date
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@index([date])
  @@index([name])
  @@map("holidays")
}

// ---------------------------------------------------------- salary slips

model SalarySlip {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  month        Int
  year         Int
  workingDays  Int
  presentDays  Int
  absentDays   Int
  basic        Decimal  @db.Decimal(12, 2)
  allowances   Decimal  @default(0) @db.Decimal(12, 2)
  deductions   Decimal  @default(0) @db.Decimal(12, 2)
  netPay       Decimal  @db.Decimal(12, 2)
  generatedBy  Int
  createdAt    DateTime @default(now()) @db.DateTime(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId, year, month])
  @@index([year, month])
  @@map("salary_slips")
}

// ------------------------------------------------------------- audit log

model AuditLog {
  id          String    @id @default(uuid())
  actorId     String?   @db.VarChar(191)
  actorRole   String    @db.VarChar(191)
  action      String    @db.VarChar(191)
  entityType  String    @db.VarChar(191)
  entityId    String    @db.VarChar(191)
  beforeValue String?   @db.Text
  afterValue  String?   @db.Text
  metadata    String?   @db.Text
  ipAddress   String?   @db.VarChar(191)
  userAgent   String?   @db.VarChar(191)
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------- refresh tokens

model RefreshToken {
  id        String    @id @default(uuid())
  userId    Int
  tokenHash String    @db.VarChar(255)
  expiresAt DateTime  @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ------------------------------------------------- password reset tokens

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    Int
  tokenHash String    @db.VarChar(255)
  expiresAt DateTime  @db.DateTime(3)
  used      Boolean   @default(false)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ------------------------------------------------------------ comp-off

model CompOffCredit {
  id         String   @id @default(uuid())
  employeeId Int
  sourceDate DateTime @db.Date
  earnedDays Decimal  @default(1) @db.Decimal(5, 2)
  usedDays   Decimal  @default(0) @db.Decimal(5, 2)
  status     String   @default("AVAILABLE") @db.VarChar(20)
  expiresAt  DateTime @db.Date
  reason     String?  @db.VarChar(500)
  approvedBy String?  @db.VarChar(191)
  approvedAt DateTime? @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ledger   CompOffLedger[]

  @@unique([employeeId, sourceDate])
  @@index([employeeId])
  @@map("comp_off_credits")
}

model CompOffLedger {
  id        String   @id @default(uuid())
  creditId  String   @db.VarChar(191)
  employeeId Int
  type      String   @db.VarChar(20)
  amount    Decimal  @db.Decimal(5, 2)
  balanceAfter Decimal @db.Decimal(5, 2)
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.DateTime(3)

  credit CompOffCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([creditId])
  @@index([employeeId])
  @@map("comp_off_ledger")
}

model CompOffPolicy {
  id             String   @id @default(uuid())
  expiryMonths   Int      @default(3)
  minWorkedHours Decimal  @default(4) @db.Decimal(4, 2)
  maxDaysPerMonth Int     @default(2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)

  @@map("comp_off_policy")
}

// --------------------------------------------------- employee profiles
//
// Payroll, WFH and attendance-correction services resolve the employee behind
// a user id through this model, which did not exist yet. Only this model and
// the ones after it are new; every table it maps to is created by the
// additive push. `designationId`/`departmentId` are plain scalar foreign keys
// because the legacy designation/department columns are not relations.

model EmployeeProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  employeeCode  String   @unique @db.VarChar(50)
  firstName     String   @db.VarChar(50) @default("")
  lastName      String   @db.VarChar(50) @default("")
  designationId Int?
  departmentId  Int?
  status        String   @default("ACTIVE") @db.VarChar(20)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  wfhRequests          WFHRequest[]
  attendanceCorrections AttendanceCorrection[]
  salaryStructures     SalaryStructure[]
  payrollRecords       PayrollRecord[]

  @@index([userId])
  @@map("employee_profiles")
}

// ------------------------------------------------------------- WFH requests

model WFHRequest {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestDate  DateTime @db.DateTime
  reason       String   @db.VarChar(500)
  status       String   @default("PENDING") @db.VarChar(20)
  reviewedBy  Int?
  reviewedAt  DateTime?
  reviewComment String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  @@index([employeeId])
  @@index([status])
  @@map("wfh_requests")
}

// ------------------------------------------- attendance correction requests

model AttendanceCorrection {
  id                Int      @id @default(autoincrement())
  attendanceId      Int
  attendance        AttendanceLog @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employeeId        Int
  employee          EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  originalPunchIn   DateTime?
  originalPunchOut  DateTime?
  originalStatus    String   @default("UNKNOWN") @db.VarChar(10)
  correctedPunchIn  DateTime?
  correctedPunchOut DateTime?
  correctedStatus   String   @default("UNKNOWN") @db.VarChar(10)
  reason            String?  @db.VarChar(500)
  status            String   @default("PENDING") @db.VarChar(20)
  reviewComment     String?  @db.VarChar(255)
  reviewedBy        Int?
  reviewedAt        DateTime?
  createdAt         DateTime @default(now()) @db.DateTime(3)
  updatedAt         DateTime @updatedAt @db.DateTime(3)

  @@index([attendanceId])
  @@index([employeeId, status])
  @@map("attendance_corrections")
}

// ------------------------------------------------------------------ payroll

model SalaryStructureComponent {
  id                Int      @id @default(autoincrement())
  salaryStructureId Int
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  name              String   @db.VarChar(100)
  description       String?  @db.VarChar(500)
  type              String   @default("EARNING") @db.VarChar(20)
  calculationType   String   @default("FIXED") @db.VarChar(30)
  amount            Decimal? @db.Decimal(14, 2)
  percentage        Decimal? @db.Decimal(5, 2)
  formula           String?
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)

  @@index([salaryStructureId, sortOrder])
  @@map("salary_structure_components")
}

model SalaryStructure {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  monthlyCTC    Decimal  @db.Decimal(12, 2)
  currency      String   @default("INR") @db.VarChar(3)
  isActive      Boolean  @default(true)
  effectiveFrom DateTime @db.DateTime(3)
  effectiveTo   DateTime?
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)

  components SalaryStructureComponent[]
  payrollRecords PayrollRecord[]

  @@unique([employeeId])
  @@index([isActive])
  @@map("salary_structures")
}

model PayrollComponent {
  id                Int      @id @default(autoincrement())
  payrollRecordId   Int
  payrollRecord     PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  name              String   @db.VarChar(100)
  type              String   @default("EARNING") @db.VarChar(20)
  amount            Decimal  @db.Decimal(12, 2) @default(0)
  sortOrder         Int      @default(0)

  @@index([payrollRecordId, sortOrder])
  @@map("payroll_components")
}

model PayrollRecord {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  employee          EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructureId Int
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  month             Int
  year              Int
  status            String   @default("DRAFT") @db.VarChar(20)
  grossEarnings     Decimal  @default(0) @db.Decimal(14, 2)
  totalDeductions   Decimal  @default(0) @db.Decimal(14, 2)
  netPay            Decimal  @default(0) @db.Decimal(14, 2)
  preparedBy        Int?
  preparedAt        DateTime?
  submittedAt       DateTime?
  approvedBy        Int?
  approvedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime @default(now()) @db.DateTime(3)

  components PayrollComponent[]
  payslips Payslip[]

  @@index([employeeId, year, month])
  @@index([year, month])
  @@map("payroll_records")
}

model Payslip {
  id              Int      @id @default(autoincrement())
  payrollRecordId Int
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  employeeId      Int
  month           Int
  year            Int
  pdfPath         String?
  generatedBy     Int
  generatedAt     DateTime @default(now()) @db.DateTime(3)

  @@unique([payrollRecordId])
  @@index([employeeId, year, month])
  @@map("payslips")
}

// ------------------------------------------------------ invitation tokens
//
// The invitation flow uses this model; the table did not exist yet.

model InvitationToken {
  id        String   @id @default(uuid())
  email     String   @db.VarChar(255)
  name      String?  @db.VarChar(120)
  role      String   @default("EMPLOYEE") @db.VarChar(20)
  tokenHash String   @db.VarChar(255)
  expiresAt DateTime @db.DateTime(3)
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([email])
  @@index([used])
  @@map("invitation_tokens")
}
